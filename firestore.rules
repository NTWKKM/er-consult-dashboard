rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedStaff() {
      return request.auth != null
        && (
          request.auth.token.get('staff', false) == true
          || (
            request.auth.token.get('email_verified', false) == true
            && request.auth.token.email is string
            && request.auth.token.email.matches('^[^@]+@mnrh\\.com$')
          )
        );
    }

    function isValidCalendarDate(year, month, day) {
      return (month in [1, 3, 5, 7, 8, 10, 12] && day <= 31)
        || (month in [4, 6, 9, 11] && day <= 30)
        || (
          month == 2
          && (
            day <= 28
            || (
              day == 29
              && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)
            )
          )
        );
    }

    function isIsoTimestamp(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$')
        && isValidCalendarDate(
          int(value[0:4]),
          int(value[5:7]),
          int(value[8:10])
        );
    }

    match /consults/{consultId} {
      allow read: if isAuthorizedStaff();
      allow create: if isAuthorizedStaff()
        && request.resource.data.keys().hasOnly(['id', 'hn', 'firstName', 'lastName', 'room', 'problem', 'createdAt', 'status', 'isUrgent', 'departments'])
        && request.resource.data.id is string
        && request.resource.data.id == consultId
        && request.resource.data.hn is string
        && request.resource.data.hn.size() > 0
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.room is string
        && request.resource.data.problem is string
        && request.resource.data.createdAt is string
        && isIsoTimestamp(request.resource.data.createdAt)
        && request.resource.data.status == "pending"
        && request.resource.data.isUrgent is bool
        && request.resource.data.departments is map;
      allow update: if isAuthorizedStaff()
        && request.resource.data.keys().hasOnly(['id', 'hn', 'firstName', 'lastName', 'room', 'problem', 'createdAt', 'status', 'isUrgent', 'departments'])
        && request.resource.data.id is string
        && request.resource.data.id == consultId
        && request.resource.data.hn is string
        && request.resource.data.hn.size() > 0
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.room is string
        && request.resource.data.problem is string
        && request.resource.data.createdAt is string
        && (
          request.resource.data.createdAt == resource.data.createdAt
          || (
            resource.data.status in ["completed", "cancelled"]
            && request.resource.data.status == "pending"
            && isIsoTimestamp(request.resource.data.createdAt)
          )
        )
        && request.resource.data.status in ["pending", "completed", "cancelled"]
        && request.resource.data.isUrgent is bool
        && request.resource.data.departments is map;
      allow delete: if false;
    }
  }
}